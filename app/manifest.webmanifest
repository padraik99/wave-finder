{
  "name": "Wave Finder",
  "short_name": "Waves",
  "description": "California surf forecast: swell, wind, tide and live buoys.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0b1420",
